---
import type { ForumPost } from '../data/forum';
import Icon from './icons/Icon.astro';

interface Props {
  post: ForumPost;
}

const { post } = Astro.props;
---

<article class="flex h-full flex-col rounded-2xl border border-border/60 bg-card p-5 shadow-sm transition-colors hover:border-primary/40">
  <p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{post.category}</p>
  <h3 class="mt-2 font-[family-name:var(--font-heading)] text-lg font-semibold leading-snug">
    <a class="text-foreground hover:text-primary" href={`/forum/${post.slug}/`}>{post.title}</a>
  </h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">{post.excerpt}</p>
  <div class="mt-4 flex items-center gap-3 text-xs text-muted-foreground">
    <span class="inline-flex items-center gap-1"><Icon name="messageCircle" size={14} /> {post.commentsCount} replies</span>
    <a
      class="inline-flex items-center gap-1 text-primary hover:underline"
      href={`/forum/${post.slug}/`}
    >
      <Icon name="arrowRight" size={14} />
      Open {post.category} thread
    </a>
  </div>
</article>
